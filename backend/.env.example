# CivicLens Configuration
# Copy this file as .env and change values as needed.

# ─── Database ───────────────────────────────────────────────
# Default (SQLite — zero setup, works out of the box):
DATABASE_URL=sqlite:///civiclens.db

# PostgreSQL (for city-scale / multi-server deployments):
# DATABASE_URL=postgresql://civiclens_user:your_password@localhost:5432/civiclens

# MySQL:
# DATABASE_URL=mysql+pymysql://civiclens_user:your_password@localhost:3306/civiclens

# ─── Server ─────────────────────────────────────────────────
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# BACKEND_HOST=127.0.0.1

# ─── Deployment Mode ────────────────────────────────────────
# Set to 1 for edge/worker nodes (backend only, no frontend UI):
# WORKER_ONLY=1

# ─── Message Queue (Redis) ──────────────────────────────────
# Enable for distributed processing across multiple worker nodes.
# Install Redis, then uncomment:
# MESSAGE_QUEUE=redis://localhost:6379
# QUEUE_CHANNEL=civiclens:detections

# ─── Edge AI Mode ───────────────────────────────────────────
# Enable for resource-constrained deployments (smaller models, lower res, frame skip).
# Set to 1 for edge devices (Raspberry Pi, low-end servers, on-camera processing):
# EDGE_MODE=1
# EDGE_IMG_SIZE=320
# EDGE_FRAME_SKIP=3
# EDGE_CONF_THRESHOLD=0.35
# EDGE_SKIP_SCENE=1

# ─── Storage ────────────────────────────────────────────────
# Auto-delete detection/evidence images older than N days (0 = disabled):
# STORAGE_RETENTION_DAYS=30

# ─── Security ───────────────────────────────────────────────
# SECRET_KEY=change-this-to-a-random-string
# TOKEN_EXPIRE_HOURS=12
